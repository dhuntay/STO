# Supabase project credentials.
# When this repo is linked to Vercel via the Supabase integration, these are
# synced automatically in the Vercel dashboard for Production/Preview. For
# local development, copy this file to .env.local and fill in the values
# from your Supabase project settings (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
